# Public repository allowlist
#
# The published repository contains one approved presentation and the runnable
# lab. Everything else at the repository root remains excluded by default.
/*

# Repository files
!/.gitattributes
!/.gitignore
!/README.md

# Approved presentation and fallback recordings
!/presentation/
/presentation/*
!/presentation/Living-Off-the-Pipeline.pptx
!/presentation/recordings/
/presentation/recordings/*
!/presentation/recordings/*.mp4
!/presentation/recordings/*.webm
!/presentation/recordings/*.mov
!/presentation/recordings/*.mkv

# Runnable lab and attendee documentation
!/lab/

# Never publish generated state, caches, secrets, or private key material.
**/.env
**/.env.*
!/lab/.env.example
**/.runtime/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage*
**/htmlcov/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.venv/
**/venv/
**/node_modules/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/credentials.json
**/kubeconfig
**/*.tfstate
**/*.tfstate.*
**/*.log
**/events.jsonl
**/deployment.json
**/~$*
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Explicit guard for the unrelated dummy SMB file-share project
**/DummyFileShare/
**/dummy_file_share/
**/build_dummy_file_share.py
